{
  "name": "billie/api-php-sdk",
  "license": "MIT",
  "type": "library",
  "description": "SDK PHP for Billie.io API",
  "homepage": "https://www.billie.io/",
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": ">=7.0",
    "phpstan/phpstan": "*",
    "rector/rector": "^0.16.0",
    "symplify/easy-coding-standard": "^11.3",
    "jasny/phpdoc-parser": "^1.0",
    "monolog/monolog": ">=2.9",
    "psr/log": "*"
  },
  "autoload": {
    "psr-4": { "Billie\\Sdk\\" : "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Billie\\Sdk\\Tests\\" : "tests/" }
  },
  "scripts": {
    "lint": [
      "./vendor/bin/rector --dry-run --clear-cache",
      "./vendor/bin/ecs --clear-cache"
    ],
    "phpstan": "./vendor/bin/phpstan analyse -c './phpstan.neon'",
    "phpunit": "./vendor/bin/phpunit -c './phpunit.xml.dist'"
  },
  "suggest": {
    "psr/log": "If a PSR-3 Logger is installed, you can enable logging for all Billie api requests. You can use all loggers which also implement PSR-3. e.g. monolog/monolog"
  }
}
